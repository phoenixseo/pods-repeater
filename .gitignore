# Dependencies
/vendor/
/node_modules/

# wp-env / local overrides (machine-specific, not versioned)
/wp-content/
*.sql
*.sqlite
.wp-env.local.json

# Build artifacts
/build/
/dist/

# Projekt-Archiv (Pods-Quellzip fuer watch-pods-install.sh, 2,6 MB, nicht versionieren)
/assets/

# Python-Bytecode der Porter-Skripte (scripts/*.py), generiert
__pycache__/
*.pyc

# PHPUnit (WPUnit-Testbasis)
/.phpunit.cache/
.phpunit.result.cache
# WP-Test-Lib ist eine nachgezogene Lib (18 MB) — nicht versionieren
/tests/wp-tests/

# OS / editor
.DS_Store
*.log

# Release-Artefakte: haengen an GitHub-Releases, nicht in die History
/dist/release/*.zip
/dist/release/*.manifest.txt
