# Dependencies
/vendor/
/node_modules/

# wp-env / local overrides (machine-specific, not versioned)
/wp-content/
*.sql
*.sqlite
.wp-env.local.json

# Build artifacts
/build/
/dist/

# Projekt-Archiv: Pods-Quellzip (2,6 MB) fuer den lokalen Testaufbau
/assets/

# Python-Bytecode der Porter-Skripte (scripts/*.py), generiert
__pycache__/
*.pyc

# PHPUnit (WPUnit-Testbasis)
/.phpunit.cache/
.phpunit.result.cache
# WP-Test-Lib (18 MB) wird nachgezogen, nicht versioniert
/tests/wp-tests/

# OS / editor
.DS_Store
*.log

# Release-Artefakte: haengen an GitHub-Releases, nicht in die History
/dist/release/*.zip
/dist/release/*.manifest.txt
